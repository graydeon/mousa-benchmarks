          "type": "string"
        },
        "supersession": {
          "description": "Return the consultation the trail recorded when it was written: whether supersession was consulted, the nullable activation and declaration identities it named and the withholding rows. This member exists only on a mousa.source_trail.v4 record; a legacy record has none. It reports recorded evidence and reinterprets nothing under the current activation projection. Requires native declaration and activation administration for this source; omitted or false keeps the filtered inspection.",
          "type": "boolean"
        },
        "trail_id": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
