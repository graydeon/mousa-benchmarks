        }
      ],
      "properties": {
        "error": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "completed_items": {
              "type": "integer"
            },
            "failed_item": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "completed_items"
          ],
          "type": [
            "null",
            "object"
          ]
        },
        "operation": {
